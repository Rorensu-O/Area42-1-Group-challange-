# Use the official .NET runtime image as base
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8443

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files
COPY ["Area42-1.ApiService/Area42-1.ApiService.csproj", "Area42-1.ApiService/"]
COPY ["Area42-1.ServiceDefaults/Area42-1.ServiceDefaults.csproj", "Area42-1.ServiceDefaults/"]

# Restore dependencies
RUN dotnet restore "Area42-1.ApiService/Area42-1.ApiService.csproj"

# Copy remaining source code
COPY . .

# Build the application
WORKDIR "/src/Area42-1.ApiService"
RUN dotnet build "Area42-1.ApiService.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "Area42-1.ApiService.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Set environment variables for Aspire
ENV ASPNETCORE_URLS=https://+:8443;http://+:8080
ENV DOTNET_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "Area42-1.ApiService.dll"]
