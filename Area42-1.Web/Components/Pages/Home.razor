@page "/"
@inherits LocalizedComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@T("Area42 - Accommodatiereserveringen in Eindhoven", "Area42 - Accommodation Reservations in Eindhoven")</PageTitle>

@if (_isChecking)
{
    <div style="display: flex; align-items: center; justify-content: center; height: 100vh; flex-direction: column;">
        <div style="font-size: 2rem; color: #003580;">⏳</div>
        <p>@T("Even geduld alstublieft...", "Please wait...")</p>
    </div>
}
else if (!_isAuthenticated)
{
    <div style="background: #e3f2fd; border: 1px solid #90caf9; border-radius: 8px; padding: 2rem; margin-bottom: 2rem; text-align: center;">
        <h3 style="margin-top: 0; color: #1565c0;">@T("Welkom bij Area42!", "Welcome to Area42!")</h3>
        <p>@T("Log in of registreer om accommodaties te boeken of voor admin-toegang.", "Sign in or register to book accommodations or for admin access.")</p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/login" class="btn btn-primary">@T("Inloggen", "Sign In")</a>
            <a href="/register" class="btn btn-outline">@T("Registreren", "Register")</a>
        </div>
    </div>

    <div class="hero-section" style="background: linear-gradient(135deg, #003580 0%, #00c0a3 100%); color: white; padding: 4rem 2rem; text-align: center; margin: -2rem -2rem 2rem -2rem;">
        <div class="container">
            <h1>🏡 Area42 @T("Accommodaties", "Accommodations")</h1>
            <p class="subtitle">@T("Ontdek unieke verblijven in het prachtige Eindhoven", "Discover unique stays in beautiful Eindhoven")</p>
            <div class="hero-buttons">
                <a href="/accommodations" class="btn btn-primary">@T("Bekijk accommodaties", "Browse Accommodations")</a>
                <a href="/register" class="btn btn-outline">@T("Aan de slag", "Get Started")</a>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="mb-4">
            <h2 style="text-align: center; margin-bottom: 2rem;">@T("Welkom bij Area42", "Welcome to Area42")</h2>
            <p style="text-align: center; font-size: 1.1rem; color: #666; margin-bottom: 3rem;">
                @T("Premium accommodaties in Eindhoven, Nederland. Of je nu een gezellige bungalow, een luxe chalet of een campingavontuur zoekt, wij hebben het perfecte verblijf voor jou.", "Premium accommodations in Eindhoven, Netherlands. Whether you're looking for a cozy bungalow, a luxurious chalet, or a camping adventure, we have the perfect stay for you.")
            </p>
        </div>

        <div class="grid grid-3 mb-4">
            <!-- Bungalow Card -->
            <div class="card accommodation-card">
                <img src="https://images.unsplash.com/photo-1570129477492-45201b8edff0?w=400&h=250&fit=crop" alt="Cozy Bungalow in Eindhoven" class="accommodation-image" />
                <div class="accommodation-info">
                    <span class="accommodation-type">@T("Bungalow", "Bungalow")</span>
                    <h3>@T("Gezellige familiebungalow", "Cozy Family Bungalow")</h3>
                    <div class="accommodation-price">€150<span style="font-size: 0.8rem;">@T("/nacht", "/night")</span></div>
                    <p>@T("Comfortabel verblijf, perfect voor gezinnen en koppels in de omgeving van Eindhoven. Moderne voorzieningen en een rustige omgeving.", "Comfortable home perfect for families and couples in Eindhoven area. Modern amenities and peaceful surroundings.")</p>
                    <div class="accommodation-details">
                        <span>👥 4 @T("gasten", "guests")</span>
                        <span>🛏️ 2 @T("slaapkamers", "bedrooms")</span>
                        <span>🚿 1 @T("badkamer", "bathroom")</span>
                    </div>
                    <a href="/accommodations" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">@T("Bekijk details", "View Details")</a>
                </div>
            </div>

            <!-- Chalet Card -->
            <div class="card accommodation-card">
                <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=400&h=250&fit=crop" alt="Luxury Chalet near Eindhoven" class="accommodation-image" />
                <div class="accommodation-info">
                    <span class="accommodation-type" style="background-color: #00c0a3;">@T("Chalet", "Chalet")</span>
                    <h3>@T("Luxe chalet", "Luxury Mountain Chalet")</h3>
                    <div class="accommodation-price">€200<span style="font-size: 0.8rem;">@T("/nacht", "/night")</span></div>
                    <p>@T("Prachtig chalet met modern design en schitterend uitzicht. Perfect voor een luxe uitje in de buurt van Eindhoven.", "Stunning chalet with modern design and spectacular views. Perfect for a premium getaway near Eindhoven.")</p>
                    <div class="accommodation-details">
                        <span>👥 6 @T("gasten", "guests")</span>
                        <span>🛏️ 3 @T("slaapkamers", "bedrooms")</span>
                        <span>🚿 2 @T("badkamers", "bathrooms")</span>
                    </div>
                    <a href="/accommodations" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">@T("Bekijk details", "View Details")</a>
                </div>
            </div>

            <!-- Camping Card -->
            <div class="card accommodation-card">
                <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?w=400&h=250&fit=crop" alt="Nature Camping near Eindhoven" class="accommodation-image" />
                <div class="accommodation-info">
                    <span class="accommodation-type" style="background-color: #ff9800;">@T("Camping", "Camping")</span>
                    <h3>@T("Natuurcamping", "Nature Camping Experience")</h3>
                    <div class="accommodation-price">€35<span style="font-size: 0.8rem;">@T("/nacht", "/night")</span></div>
                    <p>@T("Betaalbaar kamperen in de natuur. Ideaal voor liefhebbers van buitenleven en avonturiers nabij Eindhoven.", "Budget-friendly camping in beautiful nature. Great for outdoor lovers and adventurers near Eindhoven.")</p>
                    <div class="accommodation-details">
                        <span>👥 2+ @T("gasten", "guests")</span>
                        <span>⛺ @T("Tentenplek", "Tent spot")</span>
                        <span>🌲 @T("Natuurgebied", "Nature area")</span>
                    </div>
                    <a href="/accommodations" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">@T("Bekijk details", "View Details")</a>
                </div>
            </div>
        </div>

        <div class="info-section card">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
                <div>
                    <h3>🎯 @T("Waarom Area42?", "Why Choose Area42?")</h3>
                    <ul style="margin: 0; padding-left: 1.5rem; color: #666;">
                        <li>@T("Betrouwbare accommodaties", "Trusted accommodations")</li>
                        <li>@T("Beste prijzen", "Best prices")</li>
                        <li>@T("Snelle booking", "Quick booking")</li>
                        <li>@T("24/7 ondersteuning", "24/7 support")</li>
                    </ul>
                </div>

                <div>
                    <h3>🚀 @T("Snel aan de slag", "Quick Start")</h3>
                    <ol style="margin: 0; padding-left: 1.5rem; color: #666;">
                        <li><strong>@T("Bladeren", "Browse")</strong> - @T("Zoek accommodaties", "Search accommodations")</li>
                        <li><strong>@T("Controleren", "Check")</strong> - @T("Verifieer beschikbaarheid", "Verify availability")</li>
                        <li><strong>@T("Boeken", "Book")</strong> - @T("Beveilig uw reservering", "Secure your reservation")</li>
                        <li><strong>@T("Genieten", "Enjoy")</strong> - @T("Ervaar Eindhoven", "Experience Eindhoven")</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Contact Info Section -->
    <div style="background: white; padding: 3rem; border-radius: 0.5rem; margin-top: 3rem; border: 2px solid #e0e0e0;">
        <h2 style="text-align: center; margin-bottom: 2rem;">📞 @T("Contactgegevens Area42", "Area42 Contact Information")</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center;">
            <div>
                <h4>📧 @T("Email", "Email")</h4>
                <p style="margin: 0;">
                    <a href="mailto:info@area42.nl" style="color: #003580; text-decoration: none; font-weight: 600;">
                        info@area42.nl
                    </a>
                </p>
                <small style="color: #999;">@T("Reactie binnen 2 uur", "Response within 2 hours")</small>
            </div>
            <div>
                <h4>📱 @T("Telefoon", "Phone")</h4>
                <p style="margin: 0; font-weight: 600;">
                    <a href="tel:+31640284200" style="color: #003580; text-decoration: none;">
                        +31 64 028 4200
                    </a>
                </p>
                <small style="color: #999;">@T("Kantooruren: Ma-Vr 9:00-17:00", "Office hours: Mon-Fri 9:00-17:00")</small>
            </div>
            <div>
                <h4>💬 @T("Whatsapp", "Whatsapp")</h4>
                <p style="margin: 0;">
                    <a href="https://wa.me/31640284200" target="_blank" style="color: #003580; text-decoration: none; font-weight: 600;">
                        +31 64 028 4200
                    </a>
                </p>
                <small style="color: #999;">@T("Directe chat beschikbaar", "Live chat available")</small>
            </div>
            <div>
                <h4>📍 @T("Bezoekadres", "Visit Us")</h4>
                <p style="margin: 0; font-weight: 600;">
                    Area42 Eindhoven
                </p>
                <small style="color: #999;">@T("Techniekplein 4, 5600 AE Eindhoven", "Techniekplein 4, 5600 AE Eindhoven")</small>
            </div>
        </div>
    </div>

    <div style="background: linear-gradient(135deg, #003580 0%, #00c0a3 100%); color: white; padding: 3rem; border-radius: 0.5rem; text-align: center; margin-top: 3rem;">
        <h2>@T("Klaar om je verblijf te boeken?", "Ready to Book Your Stay?")</h2>
        <p style="font-size: 1.1rem; margin: 1rem 0;">@T("Bekijk onze accommodaties en vind jouw perfecte verblijf in Eindhoven", "Browse our accommodations and find your perfect getaway in Eindhoven")</p>
        <a href="/accommodations" class="btn" style="background-color: white; color: #003580; font-weight: 600;">@T("Boek nu", "Start Booking Now")</a>
    </div>
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #003580 0%, #00c0a3 100%);
        color: white;
        padding: 4rem 0;
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

    .hero-section h1 {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        color: white;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .subtitle {
        font-size: 1.3rem;
        opacity: 0.95;
        margin-bottom: 2rem;
    }

    .hero-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .accommodation-price {
        font-size: 1.8rem;
        font-weight: 700;
        color: #003580;
        margin: 0.5rem 0;
    }

    .info-section {
        background-color: #f8f9fa;
        margin-top: 3rem;
    }

    [data-theme="dark"] .info-section {
        background-color: #2d2d2d;
    }

    .accommodation-details {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
        color: #666;
        margin: 1rem 0;
        flex-wrap: wrap;
    }

    [data-theme="dark"] .accommodation-details {
        color: #999;
    }

    @@media (max-width: 768px) {
        .hero-section h1 {
            font-size: 2rem;
        }

        .subtitle {
            font-size: 1rem;
        }

        .hero-buttons {
            flex-direction: column;
        }
    }
</style>

@code {
    private bool _isChecking = true;
    private bool _isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        _isChecking = true;
        await CheckAuthenticationAndRedirect();
        _isChecking = false;
    }

    private async Task CheckAuthenticationAndRedirect()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState?.User;

        if (user?.Identity?.IsAuthenticated == true)
        {
            _isAuthenticated = true;
            var isAdmin = user.Claims.Any(c => 
                (c.Type == "userType" && c.Value == "Admin") || 
                (c.Type == "isAdmin" && c.Value == "true") ||
                (c.Type == "rank"));

            // Redirect based on user type
            var redirectUrl = isAdmin ? "/admin-dashboard" : "/reservations";
            Navigation.NavigateTo(redirectUrl);
        }
        else
        {
            _isAuthenticated = false;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        // Cleanup if needed
    }
}
