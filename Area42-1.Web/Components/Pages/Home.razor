@page "/"

<PageTitle>Area42 - Accommodation Reservations in Eindhoven</PageTitle>

<div class="hero-section" style="background: linear-gradient(135deg, #003580 0%, #00c0a3 100%); color: white; padding: 4rem 2rem; text-align: center; margin: -2rem -2rem 2rem -2rem;">
    <div class="container">
        <h1>🏡 Area42 Accommodations</h1>
        <p class="subtitle">Discover unique stays in beautiful Eindhoven</p>
        <div class="hero-buttons">
            <a href="/accommodations" class="btn btn-primary">Browse Accommodations</a>
            <a href="/register" class="btn btn-outline">Get Started</a>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="mb-4">
        <h2 style="text-align: center; margin-bottom: 2rem;">Welcome to Area42</h2>
        <p style="text-align: center; font-size: 1.1rem; color: #666; margin-bottom: 3rem;">
            Premium accommodations in Eindhoven, Netherlands. Whether you're looking for a cozy bungalow, a luxurious chalet, or a camping adventure, we have the perfect stay for you.
        </p>
    </div>

    <div class="grid grid-3 mb-4">
        <!-- Bungalow Card -->
        <div class="card accommodation-card">
            <img src="https://images.unsplash.com/photo-1570129477492-45201b8edff0?w=400&h=250&fit=crop" alt="Cozy Bungalow in Eindhoven" class="accommodation-image" />
            <div class="accommodation-info">
                <span class="accommodation-type">Bungalow</span>
                <h3>Cozy Family Bungalow</h3>
                <div class="accommodation-price">€150<span style="font-size: 0.8rem;">/night</span></div>
                <p>Comfortable home perfect for families and couples in Eindhoven area. Modern amenities and peaceful surroundings.</p>
                <div class="accommodation-details">
                    <span>👥 4 guests</span>
                    <span>🛏️ 2 bedrooms</span>
                    <span>🚿 1 bathroom</span>
                </div>
                <a href="/accommodations" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">View Details</a>
            </div>
        </div>

        <!-- Chalet Card -->
        <div class="card accommodation-card">
            <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=400&h=250&fit=crop" alt="Luxury Chalet near Eindhoven" class="accommodation-image" />
            <div class="accommodation-info">
                <span class="accommodation-type" style="background-color: #00c0a3;">Chalet</span>
                <h3>Luxury Mountain Chalet</h3>
                <div class="accommodation-price">€200<span style="font-size: 0.8rem;">/night</span></div>
                <p>Stunning chalet with modern design and spectacular views. Perfect for a premium getaway near Eindhoven.</p>
                <div class="accommodation-details">
                    <span>👥 6 guests</span>
                    <span>🛏️ 3 bedrooms</span>
                    <span>🚿 2 bathrooms</span>
                </div>
                <a href="/accommodations" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">View Details</a>
            </div>
        </div>

        <!-- Camping Card -->
        <div class="card accommodation-card">
            <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?w=400&h=250&fit=crop" alt="Nature Camping near Eindhoven" class="accommodation-image" />
            <div class="accommodation-info">
                <span class="accommodation-type" style="background-color: #ff9800;">Camping</span>
                <h3>Nature Camping Experience</h3>
                <div class="accommodation-price">€35<span style="font-size: 0.8rem;">/night</span></div>
                <p>Budget-friendly camping in beautiful nature. Great for outdoor lovers and adventurers near Eindhoven.</p>
                <div class="accommodation-details">
                    <span>👥 2+ guests</span>
                    <span>⛺ Tent spot</span>
                    <span>🌲 Nature area</span>
                </div>
                <a href="/accommodations" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">View Details</a>
            </div>
        </div>
    </div>

    <div class="info-section card">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
            <div>
                <h3>🎯 Why Choose Area42?</h3>
                <ul style="list-style: none; padding: 0;">
                    <li>✓ Best prices in Eindhoven area</li>
                    <li>✓ Verified and trusted accommodations</li>
                    <li>✓ Instant booking confirmation</li>
                    <li>✓ 24/7 customer support</li>
                    <li>✓ Flexible cancellation policy</li>
                </ul>
            </div>
            <div>
                <h3>🌍 Explore Eindhoven</h3>
                <p>Eindhoven is a vibrant city in the Netherlands known for its technology, culture, and outdoor activities. Area42 offers the perfect base for exploring this beautiful region.</p>
                <p><strong>Popular attractions:</strong></p>
                <ul style="list-style: none; padding: 0;">
                    <li>🏛️ Philips Museum</li>
                    <li>🎨 Van Gogh Museum</li>
                    <li>🚴 Cycling routes</li>
                    <li>🌳 Nature parks</li>
                </ul>
            </div>
            <div>
                <h3>📱 How It Works</h3>
                <ol style="padding-left: 1.5rem;">
                    <li><strong>Browse</strong> - Search accommodations</li>
                    <li><strong>Check</strong> - Verify availability</li>
                    <li><strong>Book</strong> - Secure your reservation</li>
                    <li><strong>Enjoy</strong> - Experience Eindhoven</li>
                </ol>
            </div>
        </div>
    </div>

    <div style="background: linear-gradient(135deg, #003580 0%, #00c0a3 100%); color: white; padding: 3rem; border-radius: 0.5rem; text-align: center; margin-top: 3rem;">
        <h2>Ready to Book Your Stay?</h2>
        <p style="font-size: 1.1rem; margin: 1rem 0;">Browse our accommodations and find your perfect getaway in Eindhoven</p>
        <a href="/accommodations" class="btn" style="background-color: white; color: #003580; font-weight: 600;">Start Booking Now</a>
    </div>
</div>

