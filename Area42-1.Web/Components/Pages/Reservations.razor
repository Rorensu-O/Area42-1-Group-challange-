@page "/reservations"
@layout MainLayout
@using Area42_1.Web.Components.Layout

<div class="container mt-4">
    <h1>My Reservations</h1>

    <div class="mb-4">
        <div class="grid grid-2">
            <div class="card">
                <div class="card-header">
                    <h3>Active Reservation</h3>
                </div>
                <div>
                    <h4>Luxury Chalet</h4>
                    <p><strong>Check-in:</strong> March 15, 2024</p>
                    <p><strong>Check-out:</strong> March 22, 2024</p>
                    <p><strong>Total Price:</strong> €1,400</p>
                    <p><strong>Status:</strong> <span style="color: #00c0a3; font-weight: 600;">Confirmed</span></p>
                    <div class="mt-3">
                        <button class="btn btn-primary">View Details</button>
                        <button class="btn btn-danger" style="margin-left: 0.5rem;">Cancel Reservation</button>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3>Past Reservation</h3>
                </div>
                <div>
                    <h4>Cozy Bungalow</h4>
                    <p><strong>Check-in:</strong> January 5, 2024</p>
                    <p><strong>Check-out:</strong> January 10, 2024</p>
                    <p><strong>Total Price:</strong> €750</p>
                    <p><strong>Status:</strong> <span style="color: #999; font-weight: 600;">Completed</span></p>
                    <button class="btn btn-primary" style="margin-top: 1rem;">View Details</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="/accommodations" class="btn btn-primary">Book Another Accommodation</a>
    </div>
</div>

@code {

}
